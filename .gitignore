# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
dist-ssr/
*.local
src-tauri/target/
src-tauri/gen/
# Bundler 工具临时目录（避免 WiX 在系统 TEMP 打包 MSI 时被杀软占用报错）
src-tauri/target/.bundler-tmp/

# 临时与日志
.tmp/
*.log
npm-debug.log*

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.sw?

# 环境变量
.env
.env.*
!.env.example

# Tauri 签名密钥
*.pem
*.key

# CLI 下载引擎运行时目录
.transferx-downloads/

# 内部过程文档与截图（PR 说明、界面截图，不入库）
docs/
